{
  "name": "american-football-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint --config oxlint.config.mjs . --deny-warnings",
    "lint:fix": "oxlint --config oxlint.config.mjs . --fix --deny-warnings",
    "fmt": "oxfmt . --config oxfmt.config.mjs --write",
    "fmt:check": "oxfmt . --config oxfmt.config.mjs --check"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
